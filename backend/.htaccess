# ==============================================================================
# ARTECH DESIGN WEBSITE (Aspirations Architects Engineers)
# BACKEND SECURITY CONFIGURATION (backend/.htaccess)
# ==============================================================================

# Disable directory index browsing
Options -Indexes

# Block direct web access to sensitive file types
<FilesMatch "\.(log|json|env|sql|md|txt|example|yml|yaml|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly deny access to private backend subdirectories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|logs|services|utils|templates|database|vendor)/ - [F,L]
</IfModule>
