# ==============================================================================
# ARTECH DESIGN WEBSITE (Aspirations Architects Engineers)
# Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env in your backend or project root:
#    cp .env.example .env
# 2. Populate the required environment variables with your real credentials.
# 3. NEVER commit real credentials, production secrets, or .env to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost/arkitect

# MySQL Database Configuration (PDO Prepared Statements)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=arkitect_db
DB_USERNAME=arkitect_user
DB_PASSWORD=your_db_password_here
DB_CHARSET=utf8mb4

# PHPMailer / SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_app_password_here
MAIL_FROM_ADDRESS=noreply@arkitect.in
MAIL_FROM_NAME="Artech Design"
LEAD_NOTIFICATION_EMAIL=aspirations@arkitect.in
MAIL_REPLY_TO_ADDRESS=aspirations@arkitect.in

# Google reCAPTCHA v3 Configuration (Server-Side Verification)
# Note: In development mode, empty secret key safely permits local testing.
RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key_here
RECAPTCHA_V3_SECRET_KEY=your_recaptcha_v3_secret_key_here
RECAPTCHA_V3_MIN_SCORE=0.5
RECAPTCHA_V3_EXPECTED_ACTION=contact_submit

# Google Sheets Lead Synchronization (Optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_RANGE=Leads!A:J
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=""

# Abuse Protection & Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600
